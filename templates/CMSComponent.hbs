/**
 * Component: {{titleCase name}}
 */

import {
  AdminBlockProps,
  Block,
  BlockProps,
  CreateComponent,
} from "@/components/registry";
import z from "zod";

export type {{pascalCase name}}Props = {
  example: string;
};

export const {{pascalCase name}}: CMSComponent<"{{kebabCase name}}", {{pascalCase name}}Props> = {
  id: "{{kebabCase name}}" as const,
  label: "{{titleCase name}}",

  ClientComponent: {{pascalCase name}}Client,
  AdminComponent: {{pascalCase name}}Admin,
  PreviewComponent: {{pascalCase name}}Preview,

  Schema: z.object({
    example: z.string().min(1).max(500).default("Example text"),
  }),
};

/**
 * This is the client-side component that will be rendered in the application.
 */
function {{pascalCase name}}Client({ data }: BlockProps<{{pascalCase name}}Props>) {
  return <div>{data.example}</div>;
}

/**
 * This is the admin component used to edit the component's data in the CMS.
 */
function {{pascalCase name}}Admin({
  id,
  useStore,
}: AdminBlockProps<{{pascalCase name}}Props>) {
  const { getBlock, updateBlock } = useStore();
  const block = getBlock(id) as Block<"{{kebabCase name}}">;

  if (!block) return null;

  return (
    <textarea
      value={block.data.example}
      onChange={(e) => updateBlock(id, { example: e.target.value })}
    ></textarea>
  );
}

/**
 * The preview component is used in the editor UI,
 * when displaying all available components.
 */
function {{pascalCase name}}Preview() {
  return <div>{{titleCase name}} Preview</div>;
}